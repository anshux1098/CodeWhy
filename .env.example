# Copy to .env. Never commit .env. Everything here is optional in Phase 0:
# the app imports and the unit tests run with no credentials at all.

GITHUB_TOKEN=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_S=60
MAX_LLM_TOKENS_PER_RUN=500000
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
GITHUB_TIMEOUT_S=30
MAX_INGESTION_PRS=200
MAX_INGESTION_ISSUES=200
MAX_REPO_SIZE_MB=1024
MAX_GRAPH_TRAVERSAL_DEPTH=3
MAX_CHAIN_LENGTH=6
MAX_EVIDENCE_ITEMS=12
MIN_SCORE=0.55

# Phase 0 additions.
# DATA_SOURCE selects the data-source implementation: fixture (Phase 0) or graph (Phase 3).
DATA_SOURCE=fixture
# MAX_GRAPH_NODES is the hard /graph node cap.
MAX_GRAPH_NODES=80
APP_ENV=dev
LOG_LEVEL=INFO
