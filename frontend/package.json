{
  "name": "frontend",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --max-warnings 999",
    "preview": "vite preview",
    "test": "vitest run",
    "record:fixtures": "node scripts/run-record-fixtures.js",
    "typegen": "openapi-typescript fixtures/recorded/openapi.json -o src/api/schema.ts",
    "check:contract": "node scripts/check-contract-drift.js",
    "check": "tsc -b && oxlint --max-warnings 999 && node scripts/check-contract-drift.js && vitest run && vite build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.2",
    "@oxlint/binding-win32-x64-msvc": "1.89.0",
    "@rolldown/binding-win32-x64-msvc": "1.2.15",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^3.0.0"
  }
}
